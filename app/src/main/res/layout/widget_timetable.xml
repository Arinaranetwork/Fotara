<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_midnight_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_timetable_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fotara Timetable"
        android:textColor="#EFE8DA"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_timetable_subheader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Loading class schedule..."
        android:textColor="#A0A5C2"
        android:textSize="12sp" />
</LinearLayout>
